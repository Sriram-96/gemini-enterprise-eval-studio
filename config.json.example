{
  "session_config": {
    "// Note": "encryption_key_secret can be a 32-character string for local development, or a GCP Secret Manager URI.",
    "encryption_key_secret": "projects/YOUR_PROJECT_ID/secrets/SESSION_ENCRYPTION_KEY/versions/latest"
  },
  "auth_providers": [
    {
      "id": "google-workspace",
      "type": "google_identity",
      "display_name": "Sign in with Google",
      "client_id": "YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com",
      "// Note": "client_secret_secret can be a plain string for local development, or a GCP Secret Manager URI.",
      "client_secret_secret": "projects/YOUR_PROJECT_ID/secrets/OAUTH_CLIENT_SECRET/versions/latest"
    },
    {
      "id": "generic-oidc",
      "type": "3p_oidc",
      "display_name": "Sign in with OIDC Provider",
      "idp_issuer_url": "https://YOUR_IDP_ISSUER_URL",
      "gcp_pool_id": "YOUR_WORKFORCE_POOL_ID",
      "gcp_provider_id": "YOUR_WORKFORCE_PROVIDER_ID",
      "client_id": "YOUR_OIDC_CLIENT_ID",
      "client_secret_secret": "projects/YOUR_PROJECT_ID/secrets/OIDC_CLIENT_SECRET/versions/latest"
    },
    {
      "id": "generic-saml",
      "type": "3p_saml",
      "display_name": "Sign in with SAML Provider",
      "idp_sso_url": "https://YOUR_IDP_SSO_URL",
      "gcp_pool_id": "YOUR_WORKFORCE_POOL_ID",
      "gcp_provider_id": "YOUR_WORKFORCE_PROVIDER_ID"
    }
  ],
  "// Note": "Optional. If configured, refresh tokens will be stored in Firestore (must be configured in Firestore Native mode) to extend sessions beyond 1 hour for Google Workspace (google_identity) and OIDC (3p_oidc) providers. SAML (3p_saml) providers do not support refresh tokens. If the collectionId does not exist, Firestore will automatically create it upon first write.",
  "firestore_config": {
    "projectId": "YOUR_GCP_PROJECT_ID",
    "databaseId": "YOUR_FIRESTORE_DATABASE_ID",
    "collectionId": "refresh_tokens",
    "// Note": "Optional. If not set, default ttlSeconds is 7 days.",
    "ttlSeconds": 604800
  },
  "// Note": "Optional. List of trusted hostnames for the application.",
  "trusted_hosts": [
    "YOUR_CUSTOM_DOMAIN.com"
  ]
}
