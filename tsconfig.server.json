{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist/server",
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "ts-node": {
    "esm": false
  },
  "include": [
    "src/server/**/*.ts"
  ],
  "exclude": [
    "src/server/**/*_test.ts"
  ]
}
